# Copy to .env and use a dedicated local PostgreSQL role/database.
DATABASE_URL=postgresql+psycopg://auditor:CHANGE_ME@127.0.0.1:55432/vlm_cnn_auditor
# Defaults to your home directory / vlm-cnn-auditor-data when omitted.
# DATA_ROOT=C:/Users/YourName/vlm-cnn-auditor-data
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b-instruct
# Both models analyze source frames 0, 5, 10, ... with regional Qwen review.
FRAME_STRIDE=5
REQUEST_TIMEOUT=120
SERVER_PORT=7860
# Optional absolute path to an explicitly installed model.
# YOLO_WEIGHTS=C:/models/yolo11n.pt
# Optional: start an existing portable local runtime with scripts/start-local.ps1.
# POSTGRES_BIN=C:/tools/postgres/pgsql/bin
# POSTGRES_DATA=C:/private/auditor-postgres-data
# POSTGRES_PORT=55432
# OLLAMA_EXE=C:/tools/ollama/ollama.exe
# OLLAMA_MODELS=C:/private/auditor-models
